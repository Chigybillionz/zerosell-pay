{
  "name": "zerosell-pay",
  "version": "1.0.0",
  "description": "ZeroSell Pay - Spend Assets Without Selling on Solana",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run start:backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix packages/shared run build && npm --prefix backend run build && npm --prefix frontend run build",
    "test": "node backend/node_modules/tsx/dist/cli.mjs --test tests/zerosell_protocol.test.ts tests/backend_api.test.ts",
    "test:unit": "node backend/node_modules/tsx/dist/cli.mjs --test tests/zerosell_protocol.test.ts",
    "test:e2e": "node backend/node_modules/tsx/dist/cli.mjs --test tests/backend_api.test.ts",
    "test:contract": "node backend/node_modules/tsx/dist/cli.mjs tests/zerosell_vault.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.66.0"
  },
  "overrides": {
    "uuid": "^9.0.1"
  }
}
