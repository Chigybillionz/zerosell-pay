{
  "name": "zerosell-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "ZeroSell Pay - Gasless Relayer, Solana Blinks & Helius Webhook Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs = require('fs'); fs.mkdirSync('dist/idl', { recursive: true }); fs.copyFileSync('src/idl/zerosell_vault.json', 'dist/idl/zerosell_vault.json');\"",
    "start": "node --experimental-require-module dist/index.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@pythnetwork/hermes-client": "^1.3.0",
    "@solana/actions": "^1.6.6",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "axios": "^1.21.1",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "uuid": "^9.0.1"
  }
}
